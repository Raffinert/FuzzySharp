<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>NET10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Raffinert.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Fastenshtein" Version="1.0.12" />
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
    <PackageReference Include="Quickenshtein" Version="1.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FuzzySharp\FuzzySharp.csproj" />
  </ItemGroup>

  <!-- Compare-Performance.ps1 sets this environment property for this build
       and the child project generated by BenchmarkDotNet. -->
  <PropertyGroup Condition="'$(FuzzySharpPerformanceBaseline)' != ''">
    <DefineConstants>$(DefineConstants);FUZZYSHARP_PERFORMANCE_BASELINE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(FuzzySharpPerformanceBaseline)' != ''">
    <Reference Include="FuzzySharp.PerformanceBaseline">
      <HintPath>$(FuzzySharpPerformanceBaseline)</HintPath>
      <Aliases>baseline</Aliases>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="BenchmarkDotNet.Artifacts\results\" />
  </ItemGroup>

</Project>
